# Telegram main bot
export MAIN_BOT_ID=stardonationservice
export MAIN_BOT_TOKEN=000000000:replace_with_real_token
export MAIN_BOT_OWNER=123456789
export MAIN_BOT_ADMINS=123456789

# Server
export DOMAIN=https://your-domain.example.com/
export WS_DOMAIN=wss://your-domain.example.com/
export PORT=5001

# Database
export DB_PATH=db/bots_data_base.sqlite

# S3
export S3_BUCKET_NAME=your_bucket
export S3_REGION=nl-ams
export S3_ENDPOINT_URL=https://s3.nl-ams.scw.cloud
export S3_WEBSITE=https://your_bucket.s3-website.nl-ams.scw.cloud
export S3_ACCESS_KEY=your_access_key
export S3_SECRET_KEY=your_secret_key

# Tuning
export CACHE_SIZE=100
export ROOM_CAPACITY=100
export MAX_STARS_DEBT=100.0
export DAYS_SINCE_LAST_PAYMENT_FOR_BLOCK=30
export DAYS_SINCE_LAST_PAYMENT_FOR_NOTIFICATION=28
export PROCENT_FOR_MAIN_BOT=0.03

RUST_LOG=info,tg_stars=debug
